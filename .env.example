# DouchkoVE - Umgebungs-Variablen fuer den Web-Stack (docker-compose).
# Kopiere diese Datei nach `.env` (NICHT ins Git! .env ist in .gitignore) und
# fuelle die Werte aus. Danach: `docker compose up -d --build`.
#
# Legende:  [BLOCKER] = ohne das geht der Launch nicht.  [Default] = optional.
# ============================================================================

# --- [BLOCKER] KI-Regie ------------------------------------------------------
# Ohne diesen Key laeuft keine Transkription / KI-Regie. Pflicht.
OPENAI_API_KEY=sk-...

# --- [BLOCKER] Admin-Panel ---------------------------------------------------
# Langes, zufaelliges Geheimnis. Damit loggst du dich in /admin ein.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DVE_ADMIN=

# --- [BLOCKER] Domain + Caddy (HTTPS) ---------------------------------------
DOMAIN=douchko.eu
DVE_PUBLIC_URL=https://douchko.eu

# --- [BLOCKER fuer Verkauf] Stripe (Live-Modus) -----------------------------
# Test:  sk_test_... / whsec_...   |   Live:  sk_live_... / whsec_...
# Das Webhook-Secret bekommst du im Stripe-Dashboard beim Anlegen des Endpoints
# (Ziel: https://<domain>/api/stripe/webhook). Ohne beide kann NIEMAND kaufen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- [BLOCKER fuer Verify/Reset] Mail-Versand -------------------------------
# ENTWEDER Resend (einfach)  ODER  SMTP (z.B. Gmail-App-Passwort). Eins reicht.
# Ohne Mail: keine E-Mail-Bestaetigung (-> kein Willkommens-Guthaben) und kein
# Passwort-Reset.
RESEND_API_KEY=
# --- oder SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DouchkoVE <noreply@douchko.eu>

# Empfaenger fuer Betriebs-Alarme (Disk voll, haengender Job, DB-Backup).
DVE_ADMIN_MAIL=ismet.01.b@gmail.com

# Kunden-Support-Adresse. Der Versand laeuft ueber die verifizierte Sende-Domain
# (MAIL_FROM, z.B. noreply@douchko.eu); Antworten auf Kunden-Mails landen aber
# per Reply-To in DIESEM Postfach. Steht auch als Kontakt im Mail-Text.
DVE_SUPPORT_MAIL=Ismet@douchkove.com

# Wie viel Betriebs-Post willst du bekommen?  (gegen Postfach-Spam)
#   all       = alles, inkl. taegliche Backup-Mail.
#   important = NUR echte Stoerungen (Job-Fehler, Platte knapp, Timeout);
#               keine taegliche Routine-Mail. (Default)
#   off       = keine Betriebs-Mails.
# Kunden-Mails (Verify/Reset/Kauf) sind davon NICHT betroffen.
# Hinweis: bei 'important'/'off' wird das Offsite-Backup NICHT gemailt - das
# lokale, rotierende DB-Backup auf der Platte laeuft aber weiter.
DVE_ALERTS=important

# --- [Default] Betrieb / Limits ---------------------------------------------
DVE_WORKERS=1               # parallele Caption-Render (1 = container-sicher)
DVE_MAX_MB=300              # Upload-Groesse-Deckel
DVE_MAX_SECONDS=180         # max. Videolaenge (Sekunden)
DVE_TRIAL_SECONDS=120       # Willkommens-Guthaben nach Verify (2 Credits)
DVE_RETENTION_DAYS=7        # fertige Videos nach N Tagen loeschen
DVE_CREDIT_DAYS=180         # Credit-Gueltigkeit (6 Monate)
DVE_INFLIGHT_CAP=3          # gleichzeitige Jobs pro Konto (Flooding-Schutz)
DVE_JOB_TIMEOUT=2400        # haengende Jobs nach N Sekunden beenden (40 Min)
DVE_MOTION_CONCURRENCY=2    # Remotion-Concurrency (Motion, ausgeblendet)

# --- [Default] "Mit Google anmelden" (optional) -----------------------------
# Leer lassen = Feature ist komplett aus (kein Button, aendert nichts). Zum
# Aktivieren: in der Google Cloud Console einen OAuth-2.0-Client (Typ
# "Webanwendung") anlegen. Autorisierte Redirect-URI dort exakt eintragen:
#   https://douchko.eu/api/auth/google/callback
# Dann die beiden Werte hierher kopieren. Passwort-Login bleibt parallel aktiv.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- [Default] Owner + Sonstiges --------------------------------------------
# Konto, das das Owner-Panel (globale Stil-Referenz) sehen darf. Setze deine
# ECHTE Login-Mail, sonst siehst du das Panel nicht (siehe LAUNCH.md).
DVE_OWNER=ismet.01.b@gmail.com
# Optional: fester Salt fuer die Anti-Farming-Hashes. Leer = wird einmal
# automatisch in data/ref_salt erzeugt (stabil ueber Neustarts).
DVE_REF_SALT=
